---
import { Image } from "astro:assets";
import aboutUsImg from "../assets/aboutus_section.webp";
import { Icon } from "astro-icon/components";
import SmallCard from "./ui/SmallCard.astro";
import Annotation from "./ui/Annotation.astro";

const paraText =  `Vinex Healthcare is dedicated to developing high-quality Ayurvedic, 
pharmaceutical, and wellness products that promote healthier lives. By combining traditional
 knowledge with modern quality standards, we deliver safe, effective, and trusted healthcare 
 solutions for every patient's needs.`;

const cardItems = [
    {title:"Quality Assured HealthCare Products" , subtitle:"Strict quality checks at every step to ensure safety and efficacy." , icon:"lucide:shield"},
    {title:"Ayurvedic & Nutraceutical Expertise" , subtitle:"Rooted in Ayurveda, powered by modern science and research." , icon:"lucide:leaf"},
    {title:"Trusted by Healthcare Professionals" , subtitle:"Preferred by doctors, partners,and customers across the globe." , icon:"lucide:users-round"},
    
]
---
<div class="bg-background flex flex-col justify-center items-center mt-12">
    <div class="mt-12">
            <Annotation  title="AboutUs" icon="none"/>

    </div>
<section class="container mx-auto grid grid-cols-1 lg:grid-cols-2 items-center gap-12 py-10 lg:py-20">

        

    <div class="mx-6 lg:mx-0">
        <Image
            src={aboutUsImg}
            alt="About Us"
            class="w-full h-auto rounded-xl object-cover"
        />
    </div>


    <div class="flex flex-col gap-4 px-4 mx-6 lg:mx-0">
       

        <h2 class="text-primary">
            Healthcare Innovation Rooted in <span class="text-secondary">Nature</span> 
        </h2>

        <p>
            {paraText}
        </p>

        <div class="flex flex-col gap-8 mt-6 md:mt-0 md:gap-4">

            {
                cardItems.map((item)=>( <SmallCard title={item.title}    subtitle={item.subtitle}   icon={item.icon} />))
            }
        
        </div>
    </div>
</section>
</div>
