---
import { Icon } from "astro-icon/components";
import { products } from "../../data/products";

const featured = products.find((product) => product.featured);

if (!featured) {
  throw new Error("No featured product found. Set featured: true in products.ts");
}
---

<section class="section">

    <div class="container">

        <div
            class="grid items-center gap-12 overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-primary to-primary/90 p-8 text-white lg:grid-cols-2 lg:p-16"
        >

            <!-- Content -->

            <div>

                <p class="annotation border-white/20 bg-white/10 text-white">
                    FEATURED PRODUCT
                </p>

                <h2 class="mt-6 text-white">
                    {featured.name}
                </h2>

                <p class="mt-6 max-w-xl leading-8 text-white/80">
                    {featured.shortDescription}
                </p>

                <!-- Benefits -->

                <div class="mt-10 grid gap-4 sm:grid-cols-2">

                    {
                        featured.benefits.map((benefit) => (

                            <div class="flex items-center gap-3">

                                <div
                                    class="flex h-10 w-10 items-center justify-center rounded-full bg-secondary"
                                >
                                    <Icon
                                        name="lucide:check"
                                        class="h-5 w-5 text-white"
                                    />
                                </div>

                                <span class="font-medium">
                                    {benefit}
                                </span>

                            </div>

                        ))
                    }


</div>


                <!-- CTA -->

                <div class="mt-12 flex flex-wrap gap-4">

                    <a
                        href={featured.amazonUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-3 rounded-full bg-secondary px-8 py-4 font-semibold text-white transition hover:scale-105 hover:shadow-xl"
                    >
                        <Icon
                            name="lucide:shopping-cart"
                            class="h-5 w-5"
                        />

                        Buy on Amazon
                    </a>

                    <span
                        class="inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-4 text-sm"
                    >

                        <Icon
                            name="lucide:badge-check"
                            class="h-5 w-5 text-secondary"
                        />

                        Official Product

                    </span>

                </div>

            </div>

            <!-- Image -->

            <div class="relative">

                <div
                    class="absolute -left-8 -top-8 h-40 w-40 rounded-full bg-secondary/20 blur-3xl"
                />

                <div
                    class="absolute -bottom-10 -right-10 h-52 w-52 rounded-full bg-white/10 blur-3xl"
                />

                <img
                    src={featured.image}
                    alt={featured.name}
                    class="relative mx-auto w-full max-w-md rounded-[2rem] bg-white object-cover p-6 shadow-2xl transition duration-500 hover:scale-105"
                />

            </div>

        </div>

    </div>

</section>

