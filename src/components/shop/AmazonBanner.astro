---
import { Icon } from "astro-icon/components";
---

<section class="section py-20">

    <div class="container">

        <div
            class="relative overflow-hidden rounded-[2.5rem] bg-primary px-8 py-16 text-white lg:px-16"
        >

            <!-- Background Decoration -->

            <div class="absolute -left-16 top-0 h-64 w-64 rounded-full bg-secondary/20 blur-3xl"></div>

            <div class="absolute -right-20 bottom-0 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>

            <div class="relative grid items-center gap-12 lg:grid-cols-2">

                <!-- Left -->

                <div>

                    <p class="annotation border-white/20 bg-white/10 text-white">
                        OFFICIAL STORE
                    </p>

                    <h2 class="mt-6 text-white">
                        Shop Genuine VenixHealthCare Products on Amazon
                    </h2>

                    <p class="mt-6 max-w-xl text-lg leading-8 text-white/80">
                        Purchase authentic VenixHealthCare products directly
                        from our official Amazon store and enjoy secure
                        ordering, reliable delivery, and trusted customer
                        support.
                    </p>

                    <!-- Features -->

                    <div class="mt-10 space-y-5">

                        <div class="flex items-center gap-4">

                            <Icon
                                name="lucide:badge-check"
                                class="h-6 w-6 text-secondary"
                            />

                            <span>100% Genuine Products</span>

                        </div>

                        <div class="flex items-center gap-4">

                            <Icon
                                name="lucide:truck"
                                class="h-6 w-6 text-secondary"
                            />

                            <span>Fast & Reliable Delivery</span>

                        </div>

                        <div class="flex items-center gap-4">

                            <Icon
                                name="lucide:shield-check"
                                class="h-6 w-6 text-secondary"
                            />

                            <span>Safe & Secure Shopping</span>

                        </div>

                    </div>

                    <!-- Button -->

                    <a
                        href="https://www.amazon.in/s?k=VENIX&ref=bl_dp_s_web_0"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-10 inline-flex items-center gap-3 rounded-full bg-secondary px-8 py-4 font-semibold text-white transition-all duration-300 hover:scale-105 hover:shadow-xl"
                    >

                        <Icon
                            name="lucide:shopping-cart"
                            class="h-5 w-5"
                        />

                        Visit Amazon Store

                        <Icon
                            name="lucide:arrow-up-right"
                            class="h-5 w-5"
                        />

                    </a>

                </div>

                <!-- Right -->

                <div class="flex justify-center">

                    <div
                        class="flex h-80 w-80 items-center justify-center rounded-full border border-white/10 bg-white/10 backdrop-blur-sm"
                    >

                        <div
                            class="flex h-56 w-56 items-center justify-center rounded-full bg-white"
                        >

                            <Icon
                                name="lucide:shopping-bag"
                                class="h-24 w-24 text-primary"
                            />

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>