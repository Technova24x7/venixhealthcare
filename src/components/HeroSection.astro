---
const heroAnnotation = Astro.props.annotation;
const heroTitle = Astro.props.title;
const heroSubtitle= Astro.props.subtitle;
const heroBg = Astro.props.bg;
const cta = Astro.props.cta;
---


<div
        style={`background-image:url(${heroBg.src})`}
        class="bg-cover w-full h-full md:h-3/4 lg:h-screen  bg-center"
    >
        <div class="container mx-auto md:h-full flex justify-start pt-36 md:pt-0 px-2 lg:px-0  md:items-center">
            <div
                class="max-w-3/4 md:max-w-6/10 flex flex-col gap-6 text-white"
            >
                <p class="annotation bg-secondary text-white uppercase">{heroAnnotation}</p>
                <h1 class="hero-title text-white">
                    {heroTitle}
                </h1>
                <p>
                    {heroSubtitle}
                </p>
                <a
                    href={cta.href}
                    class="btn btn-primary md:py-2 md:w-fit bg-secondary"
                    >{cta.title}
                </a>
            </div>
        </div>
    </div>