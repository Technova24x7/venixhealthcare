---
import { Icon } from "astro-icon/components"
import SmallCard from "./ui/SmallCard.astro"
---

<section class="relative flex flex-col justify-center items-center">
    <div class="h-[3em] w-[3em]   rounded-full absolute top-0 left-1/2 mt-[-1.5em]
     flex justify-center items-center
     -translate-x-1/2 bg-secondary text-white">
    <Icon class="h-[2em] w-[2em] relative " name="lucide:bar-chart-2" />

    </div>

    <div class="relative">
        <h5 class="pt-6 pb-2 ">Our Impact</h5>
        <span class="absolute bottom-0 left-1/2 h-1 w-12 -translate-x-1/2 rounded bg-secondary"></span>
    </div>
    

    <div
        class="w-full grid grid-cols-2 md:grid-cols-4 max-w-9/10 mx-auto gap-4 py-6 lg:py-8 mx-auto"
    >
     <SmallCard  title="500+" subtitle="CLINICAL TRIALS" icon="lucide:leafy-green"/>
     <SmallCard  title="12+"  subtitle="BOTANICAL ASSETS" icon="lucide:vegan"/>
     <SmallCard  title="85+"  subtitle="PATENTS PENDING" icon="lucide:file"/>
     <SmallCard  title="100%" subtitle="NATURAL ORIGIN" icon="lucide:shield-check"/>
     
     
     
     
     
    </div>
</section>
