---
import Layout from '../layouts/Layout.astro';
import heroBg from "../assets/heroimg-2048x1170.webp";
import Stats from '../components/Stats.astro';
import AboutusSection from '../components/AboutusSection.astro';
import WhyChooseUsSection from '../components/WhyChooseUsSection.astro';
import MedicalSolutionSection from '../components/MedicalSolutionSection.astro';
import ManufacturingExcellenceSection from '../components/ManufacturingExcellenceSection.astro';
import Annotation from '../components/ui/Annotation.astro';
const heroTitle = "Complete Care that Goes Hand in Hand.";
const heroSubtitle = `Delivering a balanced approach to wellness through our dedicated Herbal and Allopathy divisions. 
                      From nature-derived remedies to advanced pharmaceutical solutions, we ensure quality healthcare 
                      for every patient.`;

---

<Layout>

    <div class="relative">
        <section 
    style={`background-image: url(${heroBg.src})`}

    class="w-full h-fit md:h-screen  relative  bg-cover bg-center">

     <!-- Overlay -->
  <div class="absolute  inset-0 bg-gradient-to-r from-black/80 via-black/30 to-transparent"></div>
        <div class="relative z-10 container mx-auto flex flex-col gap-4 h-full py-24 md:py-0 md:justify-center text-white p-4 lg:p-0">

           
            <p class="annotation bg-secondary text-white  md:mx-0 hidden md:block"> CLINICAL NATURE</p>
            <h1 class="text-white hero-title max-w-3/4">{heroTitle}</h1>
            <p class="md:text-xl max-w-3/4">
                {heroSubtitle}
            </p>
            <div class="flex flex-wrap md:flex-nowrap mt-4 gap-4">
                <a class="btn btn-primary w-48 md:w-64 lg:w-1/4">Explore Our Products</a>
                <a class="btn btn-secondary w-48 md:w-64 lg:w-1/4 bg-white text-black">Contact Us Today</a>
            </div>
        </div>

       
       

    </section>

      <div class="relative bg-white my-[-50px] z-30 shadow-xl m-6 rounded-xl md:my-0">

        <Stats />
     </div>
    </div>
     

     <AboutusSection />

    <WhyChooseUsSection />

    <MedicalSolutionSection />
  
    <ManufacturingExcellenceSection />
  
    
</Layout>
